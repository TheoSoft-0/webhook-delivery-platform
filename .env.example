# PostgreSQL administrator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=webhook_delivery

# PostgreSQL connection
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Application database account
APP_DB_USER=webhook_app
APP_DB_PASSWORD=replace-with-a-local-password

# Database migration account
MIGRATION_DB_USER=webhook_migrator
MIGRATION_DB_PASSWORD=replace-with-a-local-password

# Encrypts destination signing secrets.
# Generate a real Fernet key for your local .env file.
DESTINATION_ENCRYPTION_KEY=replace-with-generated-fernet-key